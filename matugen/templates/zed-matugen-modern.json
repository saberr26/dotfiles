{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "VSCode Material Modern",
  "author": "kcamcam",
  "themes": [
    {
      "name": "VSCode Material Modern",
      "appearance": "dark",
      "style": {
        "background.appearance": "opaque",
        "accents": [
          "{{ colors.primary.default.hex }}",
          "{{ colors.secondary.default.hex }}",
          "{{ colors.tertiary.default.hex }}",
          "{{ colors.error.default.hex }}"
        ],
        "border": "{{ colors.outline.default.hex }}",
        "border.variant": "{{ colors.outline_variant.default.hex }}",
        "border.focused": "{{ colors.primary.default.hex }}",
        "border.selected": "{{ colors.outline.default.hex }}",
        "border.transparent": "{{ colors.outline.default.hex | set_alpha: 0.0 }}",
        "border.disabled": "{{ colors.outline.default.hex }}",
        "elevated_surface.background": "{{ colors.surface_container_high.default.hex }}",
        "surface.background": "{{ colors.surface.default.hex | set_alpha: 0.4 }}",
        "background": "{{ colors.surface.default.hex }}",
        "element.background": "{{ colors.primary.default.hex }}",
        "element.hover": "{{ colors.surface_container_highest.default.hex }}",
        "element.active": "{{ colors.primary_container.default.hex }}",
        "element.selected": "{{ colors.primary_container.default.hex }}",
        "element.disabled": null,
        "drop_target.background": "{{ colors.surface_container_high.default.hex | set_alpha: 0.5 }}",
        "ghost_element.background": null,
        "ghost_element.hover": "{{ colors.surface.default.hex | set_alpha: 0.1 }}",
        "ghost_element.active": "{{ colors.surface.default.hex | set_alpha: 0.2 }}",
        "ghost_element.selected": "{{ colors.primary_container.default.hex }}",
        "ghost_element.disabled": null,
        "text": "{{ colors.on_surface.default.hex }}",
        "text.muted": "{{ colors.on_surface_variant.default.hex }}",
        "text.placeholder": "{{ colors.on_surface.default.hex | set_alpha: 0.3 }}",
        "text.disabled": "{{ colors.on_surface.default.hex | set_alpha: 0.5 }}",
        "text.accent": null,
        "icon": null,
        "icon.muted": null,
        "icon.disabled": null,
        "icon.placeholder": null,
        "icon.accent": null,
        "debugger.accent": null,
        "status_bar.background": "{{ colors.surface_container.default.hex }}",
